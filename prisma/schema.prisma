datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model LocationPreset {
  id          String   @id @default(uuid())
  name        String   @unique
  lat         Float
  lng         Float
  description String
  riskFactors String[] // array of strings
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model EmergencyAlert {
  id           String   @id @default(uuid())
  title        String
  description  String
  severity     String   // "low", "medium", "high", "critical"
  category     String   // "Flood", "Fire", "Landslide", "Disease", etc.
  locationName String
  lat          Float
  lng          Float
  active       Boolean  @default(true)
  timestamp    DateTime @default(now())
}

model ReliefCamp {
  id          String   @id @default(uuid())
  name        String
  address     String
  lat         Float
  lng         Float
  capacity    Int
  occupancy   Int
  status      String   // "open", "filling", "full", "closed"
  waterSupply String   // "high", "medium", "low", "critical"
  foodSupply  String   // "high", "medium", "low", "critical"
  medSupply   String   // "high", "medium", "low", "critical"
  powerStatus String   // "stable", "generator", "offline"
  contact     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model RiskAssessment {
  id                   String   @id @default(uuid())
  location             String
  disasterType         String
  riskScore            Int
  impactSummary        String
  vulnerableZones      Json     // Array of zone objects
  recommendedActions   Json     // Array of action items
  resourceRequirements Json     // Array of items
  evacuationReadiness  String
  timestamp            DateTime @default(now())
}

model EvacuationRoute {
  id            String   @id @default(uuid())
  name          String
  startLat      Float
  startLng      Float
  endLat        Float
  endLng        Float
  polyline      Json     // Coordinates array [[lat, lng], ...]
  distanceKm    Float
  durationMins  Int
  safetyRating  String   // "safe", "caution", "hazard"
  hazardReason  String?
  routeType     String   // "primary", "secondary", "alternate"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
